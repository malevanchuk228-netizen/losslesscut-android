<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/silenceDetectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true">

        <!-- Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Шум"
                    android:textSize="11sp"
                    android:textColor="#CCCCCC"/>
                <ImageButton
                    android:id="@+id/infoThreshold"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_info_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#88FFFFFF"
                    android:tooltipText="@string/tooltip_noise_threshold"
                    android:tag="@string/tooltip_noise_threshold"
                    android:contentDescription="Порог шума"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnThresholdMinus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_remove_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Уменьшить порог"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:valueFrom="0.001"
                android:valueTo="0.1"
                android:stepSize="0.001"
                android:value="0.02"
                app:haloRadius="0dp"
                app:thumbRadius="5dp"
                app:trackHeight="2dp"
                android:tooltipText="@string/tooltip_noise_threshold"/>
            <ImageButton
                android:id="@+id/btnThresholdPlus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Увеличить порог"/>
            <TextView
                android:id="@+id/tvThresholdValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="2.0%"
                android:textSize="11sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Min Segment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Фрагмент"
                    android:textSize="11sp"
                    android:textColor="#CCCCCC"/>
                <ImageButton
                    android:id="@+id/infoMinSegment"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_info_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#88FFFFFF"
                    android:tooltipText="@string/tooltip_min_segment_audio"
                    android:tag="@string/tooltip_min_segment_audio"
                    android:contentDescription="Мин. длительность фрагмента"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnMinSegmentMinus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_remove_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Уменьшить длительность фрагмента"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSilenceMinSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:valueFrom="100"
                android:valueTo="5000"
                android:stepSize="100"
                android:value="100"
                app:haloRadius="0dp"
                app:thumbRadius="5dp"
                app:trackHeight="2dp"
                android:tooltipText="@string/tooltip_min_segment_audio"/>
            <ImageButton
                android:id="@+id/btnMinSegmentPlus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Увеличить длительность фрагмента"/>
            <TextView
                android:id="@+id/tvSilenceMinSegmentValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.1s"
                android:textSize="11sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Silence Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тишина"
                    android:textSize="11sp"
                    android:textColor="#CCCCCC"/>
                <ImageButton
                    android:id="@+id/infoDuration"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_info_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#88FFFFFF"
                    android:tooltipText="@string/tooltip_min_silence_duration"
                    android:tag="@string/tooltip_min_silence_duration"
                    android:contentDescription="Мин. длительность тишины"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnDurationMinus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_remove_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Уменьшить длительность тишины"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:valueFrom="200"
                android:valueTo="5000"
                android:stepSize="100"
                android:value="200"
                app:haloRadius="0dp"
                app:thumbRadius="5dp"
                app:trackHeight="2dp"
                android:tooltipText="@string/tooltip_min_silence_duration"/>
            <ImageButton
                android:id="@+id/btnDurationPlus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Увеличить длительность тишины"/>
            <TextView
                android:id="@+id/tvDurationValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.2s"
                android:textSize="11sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Padding Prefix -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="До"
                    android:textSize="11sp"
                    android:textColor="#CCCCCC"/>
                <ImageButton
                    android:id="@+id/infoPaddingPrefix"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_info_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#88FFFFFF"
                    android:tooltipText="@string/tooltip_padding_prefix"
                    android:tag="@string/tooltip_padding_prefix"
                    android:contentDescription="Запас до фрагмента"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnPaddingPrefixMinus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_remove_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Уменьшить запас до"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPaddingPrefix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:valueFrom="0"
                android:valueTo="2000"
                android:stepSize="50"
                android:value="0"
                app:haloRadius="0dp"
                app:thumbRadius="5dp"
                app:trackHeight="2dp"
                android:tooltipText="@string/tooltip_padding_prefix"/>
            <ImageButton
                android:id="@+id/btnPaddingPrefixPlus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Увеличить запас до"/>
            <TextView
                android:id="@+id/tvPaddingPrefixValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.0s"
                android:textSize="11sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Link Button Row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="16dp">
            <ImageButton
                android:id="@+id/btnLinkPadding"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_link_24"
                app:tint="@android:color/white"
                android:contentDescription="@string/content_desc_link_padding"/>
        </FrameLayout>

        <!-- Padding Postfix -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="После"
                    android:textSize="11sp"
                    android:textColor="#CCCCCC"/>
                <ImageButton
                    android:id="@+id/infoPaddingPostfix"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_info_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#88FFFFFF"
                    android:tooltipText="@string/tooltip_padding_postfix"
                    android:tag="@string/tooltip_padding_postfix"
                    android:contentDescription="Запас после фрагмента"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnPaddingPostfixMinus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_remove_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Уменьшить запас после"/>
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPaddingPostfix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:valueFrom="0"
                android:valueTo="2000"
                android:stepSize="50"
                android:value="0"
                app:haloRadius="0dp"
                app:thumbRadius="5dp"
                app:trackHeight="2dp"
                android:tooltipText="@string/tooltip_padding_postfix"/>
            <ImageButton
                android:id="@+id/btnPaddingPostfixPlus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#88FFFFFF"
                android:contentDescription="Увеличить запас после"/>
            <TextView
                android:id="@+id/tvPaddingPostfixValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.0s"
                android:textSize="11sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Mode Toggle Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="РЕЖИМ"
                android:textSize="10sp"
                android:textColor="?attr/colorAccent"
                android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/btnToggleModeSilence"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnModeDiscardSilence">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeDiscardSilence"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:textSize="10sp"
                    android:text="@string/mode_discard_matching"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeKeepSilence"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:textSize="10sp"
                    android:text="@string/mode_keep_matching"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">
            
            <TextView
                android:id="@+id/tvEstimatedCut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Тишина не найдена"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/layoutMatchNavigationSilence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnPrevMatchSilence"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_left_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_match"
                    android:tooltipText="@string/previous_match"
                    app:tint="@android:color/white"/>

                <ImageButton
                    android:id="@+id/btnNextMatchSilence"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_right_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_match"
                    android:tooltipText="@string/next_match"
                    app:tint="@android:color/white"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отмена"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:minHeight="32dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Применить"
                android:textSize="12sp"
                android:minHeight="32dp"
                android:tooltipText="@string/tooltip_apply_smart_cut"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
